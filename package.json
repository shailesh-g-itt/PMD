{
  "name": "salesforce-app",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce App",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"force-app/**/*.{cls,trigger,html,js,object,permissionset,profile,cmp,page,component}\"",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "lint": "eslint . --ext .js,.cls,.trigger",
    "pmd:check": "%PMD_PATH%\\bin\\pmd.bat check -f text -R rules.xml -d",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.1",
    "@lwc/eslint-plugin-lwc": "^3.0.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{trigger,cls,vf}": [
      "prettier --write",
      "npm run pmd:check"
    ],
    "*.{page,permissionset,profile,object,html}": [
      "prettier --write"
    ],
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.flow-meta.xml": [
      "node run-flow-analysis.cjs"
    ]
  }
}